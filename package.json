{
  "name": "convex-webhook-receiver",
  "version": "0.0.1",
  "description": "Convex component for inbound webhook ingestion with signature verification, deduplication, and retry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-potgieter/convex-webhook-receiver-mono.git",
    "directory": "packages/convex-webhook-receiver"
  },
  "homepage": "https://github.com/david-potgieter/convex-webhook-receiver-mono#readme",
  "bugs": {
    "url": "https://github.com/david-potgieter/convex-webhook-receiver-mono/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./convex.config": {
      "import": "./dist/convex.config.js",
      "types": "./dist/convex.config.d.ts"
    },
    "./_generated/component": {
      "import": "./_generated/component.js",
      "types": "./_generated/component.d.ts"
    },
    "./test": "./src/test.ts"
  },
  "scripts": {
    "build:codegen": "bunx convex codegen --component-dir ./src/component && bun run build",
    "build": "tsup",
    "test": "vitest run",
    "dev": "chokidar 'src/**/*.ts' -i '**/*.test.ts' -c 'bun run build:codegen' --initial",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "convex": ">=1.17.0",
    "@convex-dev/action-retrier": ">=0.3.0",
    "@convex-dev/workpool": ">=0.4.0"
  },
  "devDependencies": {
    "@convex-dev/action-retrier": "^0.3.0",
    "@convex-dev/workpool": "^0.4.6",
    "@convex-webhook-receiver/verifiers": "workspace:*",
    "@edge-runtime/vm": "^4.0.3",
    "convex": "^1.38.0",
    "convex-test": "^0.0.33",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
