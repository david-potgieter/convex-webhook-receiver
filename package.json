{
  "name": "convex-webhook-receiver",
  "version": "1.0.5",
  "license": "Apache-2.0",
  "description": "Convex component for inbound webhook ingestion with signature verification, deduplication, and retry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-potgieter/convex-webhook-receiver-mono.git",
    "directory": "packages/convex-webhook-receiver"
  },
  "homepage": "https://github.com/david-potgieter/convex-webhook-receiver-mono#readme",
  "bugs": {
    "url": "https://github.com/david-potgieter/convex-webhook-receiver-mono/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./convex.config": {
      "types": "./src/component/convex.config.ts",
      "import": "./dist/convex.config.js"
    },
    "./_generated/component": "./src/component/_generated/component.ts",
    "./test": "./src/test.ts"
  },
  "scripts": {
    "codegen": "bunx convex codegen --component-dir ./src/component",
    "build": "bunx convex codegen --component-dir ./src/component && tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "convex": ">=1.17.0"
  },
  "devDependencies": {
    "@convex-webhook-receiver/verifiers": "workspace:*",
    "@edge-runtime/vm": "^4.0.3",
    "@vitest/coverage-v8": "2.1.9",
    "convex": "^1.38.0",
    "convex-test": "^0.0.33",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
